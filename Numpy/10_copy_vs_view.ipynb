   "source": [
    "### copy() -> creates a deep copy\n",
    "### view() -> creates a shallow copy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "29d51e95",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "735cbb27",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1 2 3 4 5]\n",
      "[ 1 45  3  4  5]\n"
     ]
    }
   ],
   "source": [
    "arr1 = np.array([1,2,3,4,5])\n",
    "co = arr1.copy()\n",
    "\n",
    "co[1] = 45\n",
    "\n",
    "print(arr1)\n",
    "print(co)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b072157e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[ 1 45  3  4  5]\n",
      "[ 1 45  3  4  5]\n"
     ]
    }
   ],
   "source": [
    "arr2 = np.array([1,2,3,4,5])\n",
    "vi = arr2.view()\n",
    "\n",
    "vi[1] = 45\n",
    "\n",
    "print(arr2)\n",
    "print(vi)"
   ]
  }
 ],
